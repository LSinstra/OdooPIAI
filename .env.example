# =====================================================================
# OdooPIAI — environment configuration
# Copy to .env and fill in. install.sh will do this for you interactively.
# =====================================================================

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
CLAUDE_MODEL=claude-opus-4-7
# Optional fallback model for lightweight calls (standup summaries, etc.)
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001

# --- App secrets (install.sh generates these automatically) ---
# Fernet key, used to encrypt Odoo API keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=REPLACE_ME
# JWT signing secret.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_ME

# --- Bind / ports ---
# Port the FastAPI app listens on. Tailscale reaches the Pi directly — no public exposure.
APP_PORT=8080
APP_HOST=0.0.0.0

# --- Database ---
POSTGRES_USER=odoopiai
POSTGRES_PASSWORD=odoopiai
POSTGRES_DB=odoopiai
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- App behavior ---
APP_ENV=production
LOG_LEVEL=INFO
TIMEZONE=UTC

# Redact emails/phones from task text before sending to Claude.
REDACT_PII=true

# --- Scheduler ---
DAILY_DIGEST_HOUR=8
DAILY_DIGEST_MINUTE=0
RISK_SCAN_INTERVAL_HOURS=4

# --- Auto-updater (systemd timer on the Pi) ---
# Which branch the Pi tracks. Change if you want a stable branch.
UPDATE_BRANCH=claude/odoo-ai-raspberry-pi-8I4Aa
# How often to check for updates (seconds). systemd timer uses this.
UPDATE_INTERVAL_SECONDS=30
